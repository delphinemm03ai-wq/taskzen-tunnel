# Claude Tunnel OS — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs.
# Le plus simple : lance /onboarding dans Claude Code, il remplit tout pour toi.

# ── Airtable (CRM des leads) ──────────────────────────────
# Token : https://airtable.com/create/tokens
# Scopes : data.records:read/write, schema.bases:read/write
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=Leads

# ── Resend (envoi de la ressource par email) ──────────────
# Clé : https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── PostHog (analytics du funnel) ─────────────────────────
# Project API key (phc_...) : Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Pour le dashboard /admin :
# Personal API key : https://app.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ── Supabase (contacts et tags du tunnel, tables tunnel_*) ─
# Serveur uniquement : ne jamais préfixer ces noms par NEXT_PUBLIC_.
# URL du projet : Dashboard Supabase -> Project Settings -> API
SUPABASE_URL=
# Clé service_role (pleins pouvoirs, passe outre la RLS) : jamais côté client,
# jamais commitée. Même endroit que l'URL.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin (protège le dashboard /admin) ───────────────────
ADMIN_SECRET=

# ── Cron (relances email J+2/J+4/J+7, protège /api/cron/relances) ─
# Génère une valeur aléatoire, Vercel l'envoie automatiquement en
# "Authorization: Bearer <valeur>" pour les cron jobs configurés dans vercel.json.
CRON_SECRET=

# ── Stripe (vente par Checkout et webhook signé, story s04) ─
# Serveur uniquement. Clé secrète de test (sk_test_...) : Dashboard Stripe -> Développeurs -> Clés API.
# Une clé sk_live_ est refusée par le code tant que STRIPE_ALLOW_LIVE ne vaut pas "oui".
# STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_...) : en local, celui affiché par
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# STRIPE_WEBHOOK_SECRET=
# Passage en prod, seulement après validation de Delphine :
# STRIPE_ALLOW_LIVE=oui

# ── App ───────────────────────────────────────────────────
# En local : http://localhost:3000 — en prod : ton URL Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Note : Cal.com (réservation) se configure dans config.ts > booking
# (calUsername + calEventSlug), pas ici (ce sont des valeurs publiques).
